{
  "name": "yuto-care",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "start:dev": "cross-env APP_ENV=development DOTENV_CONFIG_PATH=.env.development expo start --dev-client",
    "start:stg": "cross-env APP_ENV=staging DOTENV_CONFIG_PATH=.env.staging expo start --dev-client",
    "start:prod": "cross-env APP_ENV=production DOTENV_CONFIG_PATH=.env.production expo start --dev-client",

    "ios:dev": "cross-env APP_ENV=development DOTENV_CONFIG_PATH=.env.development npx expo run:ios --device",
    "ios:stg": "cross-env APP_ENV=staging DOTENV_CONFIG_PATH=.env.staging npx expo run:ios --device",
    "ios:prod": "cross-env APP_ENV=production DOTENV_CONFIG_PATH=.env.production npx expo run:ios --device",

    "android:dev": "cross-env APP_ENV=development DOTENV_CONFIG_PATH=.env.development npx expo run:android",
    "android:stg": "cross-env APP_ENV=staging DOTENV_CONFIG_PATH=.env.staging npx expo run:android",
    "android:prod": "cross-env APP_ENV=production DOTENV_CONFIG_PATH=.env.production npx expo run:android",
    
    "prebuild": "expo prebuild --clean",
    "pod-install": "cd ios && pod install && cd ..",
    "setup": "npm run prebuild && npm run pod-install",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@reduxjs/toolkit": "^2.11.2",
    "axios": "^1.13.2",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "~54.0.0",
    "expo": "~54.0.29",
    "expo-constants": "~18.0.12",
    "expo-dev-client": "~6.0.20",
    "expo-font": "~14.0.10",
    "expo-keep-awake": "~15.0.7",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.9",
    "expo-router": "~6.0.19",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.12",
    "expo-status-bar": "~3.0.8",
    "expo-web-browser": "~15.0.10",
    "nativewind": "^4.2.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-worklets": "0.5.1",
    "react-redux": "^9.2.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.10",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.17",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "react-refresh": "^0.18.0",
    "react-test-renderer": "^19.1.0",
    "tailwindcss": "^3.4.18",
    "typescript": "~5.9.2"
  },
  "private": true
}
