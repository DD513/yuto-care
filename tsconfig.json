{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@assets/*": ["assets/*"],
      "@test-utils/*": ["test-utils/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "app",
    "src",
    "nativewind-env.d.ts",
    "test-utils",
    "__tests__/contexts"
  ]
}
